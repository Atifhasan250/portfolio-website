{
  "version": 2,
  "builds": [
    {
      "src": "server/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/index.ts"
    },
    {
      "src": "^/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "^/(.*\\.(js|css|png|webp|jpg|jpeg|gif|ico|svg|json|txt|xml))$",
      "dest": "/$1"
    },
    {
      "src": "^/projects/?$",
      "dest": "/projects.html"
    },
    {
      "src": "^/admin(?:/(?:dashboard|analytics|audit-log))?/?$",
      "dest": "/admin.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "^/?$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ],
  "installCommand": "npm install",
  "buildCommand": "npm run build"
}
